%% How the Latitude design system fits together.
%% Source of truth: this repo (code). Figma mirrors it.
%% Edit this file, then re-render: npx -y @mermaid-js/mermaid-cli -i docs/design-system-overview.mmd -o docs/design-system-overview.svg
flowchart TB
    rule{{"Code in this repo is the source of truth. Figma mirrors it."}}

    subgraph repo["SOURCE OF TRUTH · design-system-test repo"]
        direction LR
        skills["Agent skills<br/>build UI · review UI<br/>add component · sync Figma"]
        cli["Starter CLI<br/>npm create @latitudelabs"]
        docs["Storybook docs<br/>foundations · components · patterns"]
        tokens[("Tokens<br/>colors · type · radius · shadows<br/>light + dark")]
        components["Svelte components + 62 icons<br/>shadcn-svelte + Bits UI"]
    end

    subgraph figma["MIRROR · Figma library"]
        direction TB
        figVars["Variables + text & shadow styles<br/>Light + Dark modes"]
        figComps["Components + icon library<br/>linked to code via Code Connect"]
    end

    subgraph dist["DISTRIBUTION · set up, not live yet"]
        direction LR
        ci["CI + release<br/>GitHub Actions · changesets"]
        registry[("GitHub Packages<br/>npm install @latitudelabs/design-system")]
    end

    subgraph teams["PRODUCT TEAMS"]
        direction LR
        apps["Product apps<br/>SvelteKit"]
        devs(["Developers + AI coding agents"])
        designers(["Designers"])
    end

    rule --- tokens
    tokens -->|styles| components
    components -->|documented in| docs

    tokens ==>|mirrored to| figVars
    components ==>|mirrored to| figComps
    figVars -.->|proposals, reviewed into code| tokens

    components -.->|released by| ci
    ci -.-> registry
    registry -.-> apps
    cli -->|scaffolds| apps
    skills -->|synced into every app| devs

    devs -->|read| docs
    devs -->|build| apps
    figComps -->|used by| designers

    classDef truth fill:#ffffff,stroke:#1f6f43,stroke-width:2px,color:#13261b
    classDef mirror fill:#ffffff,stroke:#6b4fbb,stroke-width:2px,color:#1f1640
    classDef pending fill:#ffffff,stroke:#2f6db5,stroke-width:1.5px,stroke-dasharray:5 4,color:#10243d
    classDef people fill:#ffffff,stroke:#a66a00,stroke-width:1.5px,color:#2b1d00
    classDef ruleStyle fill:#1a1a1a,stroke:#1a1a1a,color:#ffffff

    class tokens,components,skills,cli,docs truth
    class figVars,figComps mirror
    class ci,registry pending
    class apps,devs,designers people
    class rule ruleStyle

    style repo fill:#e6f4ea,stroke:#1f6f43,stroke-width:2px,color:#13261b
    style figma fill:#efeafc,stroke:#6b4fbb,stroke-width:2px,color:#1f1640
    style dist fill:#e7f0fb,stroke:#2f6db5,stroke-dasharray:6 4,color:#10243d
    style teams fill:#fdf3e1,stroke:#a66a00,color:#2b1d00

    linkStyle 3,4 stroke:#1a1a1a,stroke-width:3px
